    "@tutribu/types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "catalog:",
    "elysia": "^1.3.21",
    "google-auth-library": "^10.5.0",
    "nodemailer": "^8.0.1",
    "prisma": "^7.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
