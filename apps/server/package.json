{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.13",
    "@elysiajs/static": "^1.4.7",
    "@prisma/client": "^7.4.1",
    "@tutribu/db": "workspace:*",
    "@tutribu/env": "workspace:*",
    "@tutribu/types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "catalog:",
    "elysia": "^1.3.21",
    "google-auth-library": "^10.5.0",
    "prisma": "^7.4.1",
    "stripe": "^20.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tutribu/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "^5"
  }
}
