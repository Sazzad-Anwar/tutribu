enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum UserType {
  SELF
  GUEST
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  authProvider        AuthProvider         @default(PASSWORD)
  customerId          String?
  avatarUrl           String?
  refreshTokens       RefreshToken[]
  userInfos           UserInfo[]
  passwordResetTokens PasswordResetToken[]

  @@index([createdAt])
  @@index([customerId])
}

model UserInfo {
  id          String    @id @default(cuid())
  phoneNumber String?
  gender      String?
  dateOfBirth DateTime?
  firstName   String?
  lastName    String?
  country     String?
  address     String?
  zipCode     String?
  city        String?
  bookings    Booking[]
  userType    UserType  @default(SELF)
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?
}

model RefreshToken {
  id                String   @id @default(cuid())
  tokenHash         String   @unique
  userId            String
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  revoked           Boolean  @default(false)
  replacedByTokenId String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revoked])
  @@index([replacedByTokenId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}
