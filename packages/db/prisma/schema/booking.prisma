// Booking schema: bookings, extra features, and promotional codes.
// Added indexes to improve query performance for large datasets (millions of rows).
// Keep indexes targeted to real query patterns to avoid excessive write overhead.

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CheckingType {
  SELF
  GUEST
}

enum PaymentPlan {
  LOWEST_DEPOSIT
  THREE_MONTH
  SIX_MONTH
  ONE_TIME
}

model Booking {
  id                    String           @id @default(cuid())
  specialRequest        String?
  bookingStatus         BookingStatus    @default(PENDING)
  paymentStatus         PaymentStatus    @default(PENDING)
  paymentPlan           PaymentPlan      @default(ONE_TIME)
  groupId               String
  totalAmount           Float
  amountPaid            Float            @default(0)
  stripePaymentIntentId String?
  stripeSubscriptionId  String?
  checkingType          CheckingType     @default(SELF)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  promotionalCode       PromotionalCode? @relation(fields: [promotionalCodeId], references: [id])
  promotionalCodeId     String?
  userInfoId            String
  userInfo              UserInfo         @relation(fields: [userInfoId], references: [id])

  @@index([userInfoId])
  @@index([userInfoId, createdAt])
  @@index([groupId])
  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([promotionalCodeId])
  @@index([createdAt])
  @@index([groupId, bookingStatus])
}

model PromotionalCode {
  id        String    @id @default(cuid())
  code      String    @unique
  discount  Float
  validFrom DateTime
  validTo   DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  // Indexes for validity window queries and time-based scans
  @@index([validFrom])
  @@index([validTo])
  @@index([createdAt])
}
