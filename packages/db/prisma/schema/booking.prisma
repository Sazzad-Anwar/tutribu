// Booking schema: bookings, extra features, and promotional codes.
// Added indexes to improve query performance for large datasets (millions of rows).
// Keep indexes targeted to real query patterns to avoid excessive write overhead.

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CheckingType {
  SELF
  GUEST
}

enum PaymentPlan {
  LOWEST_DEPOSIT
  THREE_MONTH
  SIX_MONTH
  ONE_TIME
}

model Booking {
  id                    String        @id @default(cuid())
  specialRequest        String?
  bookingStatus         BookingStatus @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  paymentPlan           PaymentPlan   @default(ONE_TIME)
  groupId               String
  totalAmount           Float
  amountPaid            Float         @default(0)
  stripePaymentIntentId String?
  stripeSubscriptionId  String?
  usedDiscountLink      String?
  checkingType          CheckingType  @default(SELF)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  userInfoId            String
  userInfo              UserInfo      @relation(fields: [userInfoId], references: [id])
  tripId                Int

  @@index([userInfoId])
  @@index([userInfoId, createdAt])
  @@index([groupId])
  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([groupId, bookingStatus])
}
