{
  "name": "tutribu",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "@prisma/client": "^7.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @tutribu/db db:push",
    "db:studio": "turbo -F @tutribu/db db:studio",
    "db:generate": "turbo -F @tutribu/db db:generate",
    "db:migrate": "turbo -F @tutribu/db db:migrate"
  },
  "dependencies": {
    "@tutribu/env": "workspace:*",
    "dotenv": "^17.2.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tutribu/config": "workspace:*",
    "@types/bun": "^1.3.5",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.5"
}
